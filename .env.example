# Copiá este archivo como .env.local y completá los valores. No lo subas con claves.

# IA (usá una de estas)
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_PROVIDER=gateway            # fuerza el AI Gateway de Vercel
# GEMINI_MODEL_MAIN=gemini-3.5-flash-lite   # si el modelo principal se queda sin cupo

# Respaldo: si Gemini se queda sin cupo, sigue solo por el AI Gateway de Vercel.
# En Vercel no hace falta clave (usa OIDC). En local, cargá AI_GATEWAY_API_KEY.
# AI_GATEWAY_API_KEY=
# AI_FALLBACK=off                       # apaga el respaldo
# GATEWAY_MODEL_MAIN=google/gemini-3.5-flash   # por defecto, el mismo Gemini vía Gateway
# GATEWAY_MODEL_FAST=google/gemini-3.5-flash-lite
# GATEWAY_SEARCH_MODEL=perplexity/sonar  # canal "Asistentes de IA" de Visibilidad con Gemini agotado

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcionales
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SERPER_API_KEY=
APIFY_TOKEN=
